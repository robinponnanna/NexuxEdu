# NexuxEdu Environment Configuration Example

# JWT Security
JWT_SECRET_KEY=omnicampus-super-secret-jwt-key-2026-secure-hackathon

# Database (defaults to backend/campus.db)
DATABASE_URL=sqlite+aiosqlite:///backend/campus.db

# LLM Providers (Optional - system falls back to local deterministic RAG if unset)
GROQ_API_KEY=
OPENAI_API_KEY=

# YouTube Data API v3 (Optional - system generates deterministic search fallback URLs if unset)
YOUTUBE_API_KEY=

# ElevenLabs TTS (Optional - system uses EdgeTTS neural voices by default)
ELEVENLABS_API_KEY=
